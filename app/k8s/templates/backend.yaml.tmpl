apiVersion: v1
kind: ConfigMap
metadata:
  name: backend-config
  namespace: ${PROJECT_NAME}
data:
  DB_HOST: "${DB_HOST}"
  DB_PORT: "5432"
  DB_NAME: "${DB_NAME}"
  DB_USER: "${DB_USER}"
  S3_BUCKET_NAME: "${S3_BUCKET_NAME}"
  AWS_REGION: "${AWS_REGION}"
  USE_IAM_AUTH: "true"
---
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: ${PROJECT_NAME}
type: Opaque
data:
  DB_PASSWORD: "${DB_PASSWORD_BASE64}"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${PROJECT_NAME}-backend-sa
  namespace: ${PROJECT_NAME}
  annotations:
    eks.amazonaws.com/role-arn: "${BACKEND_ROLE_ARN}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${PROJECT_NAME}-backend
  namespace: ${PROJECT_NAME}
  labels:
    app: ${PROJECT_NAME}-backend
spec:
  replicas: 2
  selector:
    matchLabels:
      app: ${PROJECT_NAME}-backend
  template:
    metadata:
      labels:
        app: ${PROJECT_NAME}-backend
    spec:
      serviceAccountName: ${PROJECT_NAME}-backend-sa
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
      containers:
      - name: backend
        image: "${ECR_REGISTRY}/${ECR_BACKEND_REPOSITORY}:${IMAGE_TAG}"
        imagePullPolicy: Always
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
              - ALL
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        ports:
        - containerPort: 5000
          name: http
        envFrom:
        - configMapRef:
            name: backend-config
        env:
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: backend-secret
              key: DB_PASSWORD
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: 250m
            memory: 256Mi
        livenessProbe:
          httpGet:
            path: /api/liveness
            port: 5000
          initialDelaySeconds: 15
          periodSeconds: 15
        readinessProbe:
          httpGet:
            path: /api/health
            port: 5000
          initialDelaySeconds: 10
          periodSeconds: 10
      volumes:
      - name: tmp
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: backend
  namespace: ${PROJECT_NAME}
  labels:
    app: ${PROJECT_NAME}-backend
spec:
  ports:
  - port: 5000
    targetPort: 5000
    protocol: TCP
    name: http
  selector:
    app: ${PROJECT_NAME}-backend

---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: ${PROJECT_NAME}-backend-hpa
  namespace: ${PROJECT_NAME}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: ${PROJECT_NAME}-backend
  minReplicas: 2
  maxReplicas: 5
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
