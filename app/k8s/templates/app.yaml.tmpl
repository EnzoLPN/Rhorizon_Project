apiVersion: v1
kind: ConfigMap
metadata:
  name: ${PROJECT_NAME}-app-config
  namespace: ${PROJECT_NAME}
data:
  DB_HOST: "${DB_HOST}"
  DB_PORT: "5432"
  DB_NAME: "${DB_NAME}"
  DB_USER: "${DB_USER}"
  S3_BUCKET_NAME: "${S3_BUCKET_NAME}"
  AWS_REGION: "${AWS_REGION}"
---
apiVersion: v1
kind: Secret
metadata:
  name: ${PROJECT_NAME}-app-secret
  namespace: ${PROJECT_NAME}
type: Opaque
data:
  DB_PASSWORD: "${DB_PASSWORD_BASE64}"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${PROJECT_NAME}-app-sa
  namespace: ${PROJECT_NAME}
  annotations:
    eks.amazonaws.com/role-arn: "${APP_ROLE_ARN}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${PROJECT_NAME}-app
  namespace: ${PROJECT_NAME}
  labels:
    app: ${PROJECT_NAME}-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: ${PROJECT_NAME}-app
  template:
    metadata:
      labels:
        app: ${PROJECT_NAME}-app
    spec:
      serviceAccountName: ${PROJECT_NAME}-app-sa
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
      containers:
      - name: app
        image: "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
        imagePullPolicy: Always
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false # Nginx/Supervisor require some writes, though configured for tmp
          capabilities:
            drop:
              - ALL
            add:
              - CHOWN
              - SETGID
              - SETUID
        ports:
        - containerPort: 8080
          name: http
        envFrom:
        - configMapRef:
            name: ${PROJECT_NAME}-app-config
        env:
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: ${PROJECT_NAME}-app-secret
              key: DB_PASSWORD
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: 500m
            memory: 512Mi
        livenessProbe:
          httpGet:
            path: /api/liveness
            port: 8080
          initialDelaySeconds: 20
          periodSeconds: 15
        readinessProbe:
          httpGet:
            path: /api/health
            port: 8080
          initialDelaySeconds: 15
          periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: ${PROJECT_NAME}-app
  namespace: ${PROJECT_NAME}
  labels:
    app: ${PROJECT_NAME}-app
spec:
  ports:
  - port: 80
    targetPort: 8080
    protocol: TCP
    name: http
  selector:
    app: ${PROJECT_NAME}-app
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: ${PROJECT_NAME}-app-hpa
  namespace: ${PROJECT_NAME}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: ${PROJECT_NAME}-app
  minReplicas: 2
  maxReplicas: 5
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
