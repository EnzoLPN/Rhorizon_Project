apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${PROJECT_NAME}-db
  namespace: ${PROJECT_NAME}
  labels:
    app: ${PROJECT_NAME}-db
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ${PROJECT_NAME}-db
  template:
    metadata:
      labels:
        app: ${PROJECT_NAME}-db
    spec:
      containers:
      - name: db
        image: postgres:16-alpine
        env:
        - name: POSTGRES_DB
          value: ${PROJECT_NAME}_dev
        - name: POSTGRES_USER
          value: dbadmin
        - name: POSTGRES_PASSWORD
          value: RHZorionDevPass2026!
        ports:
        - containerPort: 5432
          name: postgres
        resources:
          requests:
            cpu: 50m
            memory: 64Mi
          limits:
            cpu: 200m
            memory: 128Mi
        volumeMounts:
        - name: db-storage
          mountPath: /var/lib/postgresql/data
      volumes:
      - name: db-storage
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: db
  namespace: ${PROJECT_NAME}
spec:
  ports:
  - port: 5432
    targetPort: 5432
    protocol: TCP
    name: postgres
  selector:
    app: ${PROJECT_NAME}-db
