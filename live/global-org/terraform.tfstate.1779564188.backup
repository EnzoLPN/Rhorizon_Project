    {
      "module": "module.accounts_baseline",
      "mode": "managed",
      "type": "aws_organizations_policy",
      "name": "deny_public_s3",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:organizations::343218196208:policy/o-faytjxsk3f/service_control_policy/p-0ahwbizy",
            "content": "{\"Statement\":[{\"Action\":[\"s3:DeleteBucketPublicAccessBlock\",\"s3:DeleteAccountPublicAccessBlock\"],\"Effect\":\"Deny\",\"Resource\":\"*\",\"Sid\":\"DenyS3PublicAccessBlockDeletion\"},{\"Action\":[\"s3:PutBucketPublicAccessBlock\",\"s3:PutAccountPublicAccessBlock\"],\"Condition\":{\"Bool\":{\"s3:PublicAccessBlockConfiguration/BlockPublicAcls\":\"false\"}},\"Effect\":\"Deny\",\"Resource\":\"*\",\"Sid\":\"DenyS3BlockPublicAclsFalse\"},{\"Action\":[\"s3:PutBucketPublicAccessBlock\",\"s3:PutAccountPublicAccessBlock\"],\"Condition\":{\"Bool\":{\"s3:PublicAccessBlockConfiguration/IgnorePublicAcls\":\"false\"}},\"Effect\":\"Deny\",\"Resource\":\"*\",\"Sid\":\"DenyS3IgnorePublicAclsFalse\"},{\"Action\":[\"s3:PutBucketPublicAccessBlock\",\"s3:PutAccountPublicAccessBlock\"],\"Condition\":{\"Bool\":{\"s3:PublicAccessBlockConfiguration/BlockPublicPolicy\":\"false\"}},\"Effect\":\"Deny\",\"Resource\":\"*\",\"Sid\":\"DenyS3BlockPublicPolicyFalse\"},{\"Action\":[\"s3:PutBucketPublicAccessBlock\",\"s3:PutAccountPublicAccessBlock\"],\"Condition\":{\"Bool\":{\"s3:PublicAccessBlockConfiguration/RestrictPublicBuckets\":\"false\"}},\"Effect\":\"Deny\",\"Resource\":\"*\",\"Sid\":\"DenyS3RestrictPublicBucketsFalse\"},{\"Action\":[\"s3:PutBucketAcl\",\"s3:PutObjectAcl\"],\"Condition\":{\"StringEquals\":{\"s3:x-amz-grant-public-read\":\"true\",\"s3:x-amz-grant-public-write\":\"true\"}},\"Effect\":\"Deny\",\"Resource\":\"*\",\"Sid\":\"DenyPublicBucketACLs\"}],\"Version\":\"2012-10-17\"}",
            "description": "Empeche la desactivation du Block Public Access et l'usage d'ACLs publiques sur S3",
            "id": "p-0ahwbizy",
            "name": "deny-public-s3",
            "skip_destroy": null,
            "tags": null,
            "tags_all": {},
            "type": "SERVICE_CONTROL_POLICY"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
    {
      "module": "module.accounts_baseline",
      "mode": "managed",
      "type": "aws_organizations_policy",
      "name": "eu_only",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:organizations::343218196208:policy/o-faytjxsk3f/service_control_policy/p-kb2p08yf",
            "content": "{\"Statement\":[{\"Condition\":{\"StringNotEquals\":{\"aws:RequestedRegion\":[\"eu-west-1\",\"eu-central-1\",\"eu-west-2\"]}},\"Effect\":\"Deny\",\"NotAction\":[\"iam:*\",\"organizations:*\",\"route53:*\",\"budgets:*\",\"support:*\",\"sso:*\",\"identitystore:*\",\"cloudfront:*\",\"waf:*\",\"wafv2:*\",\"acm:*\",\"globalaccelerator:*\"],\"Resource\":\"*\",\"Sid\":\"DenyAllOutsideEU\"}],\"Version\":\"2012-10-17\"}",
            "description": "Interdit le deploiement de ressources en dehors des regions europeennes autorisees",
            "id": "p-kb2p08yf",
            "name": "eu-only-regions",
            "skip_destroy": null,
            "tags": null,
            "tags_all": {},
            "type": "SERVICE_CONTROL_POLICY"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
